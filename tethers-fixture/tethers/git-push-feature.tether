tether "permission slip git.push.feature"

anchor
    permission_slip.action_requested

when
    actor.trusted is true

do
    git.push.feature
        repository: anchor.repository
        remote_repository: anchor.remote_repository
        destination_ref: anchor.destination_ref
        push_effect: anchor.push_effect
        source_commit: anchor.source_commit
        remote_transport_digest: anchor.remote_transport_digest
